APP_NAME=EcoVision
APP_ENV=local

# Pesos treinados no Colab (MyDrive/EcoVision/runs/<RUN_NAME>/weights/best.pt).
# Sem este arquivo, use yolo11n.pt: o modelo genérico COCO (não conhece lata/sacola).
YOLO_MODEL_PATH=best.pt
YOLO_CONFIDENCE=0.25

# Pasta "resultados" copiada do Colab (MyDrive/EcoVision/resultados)
RESULTS_DIR=resultados

MAX_IMAGE_SIZE_BYTES=10485760
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
